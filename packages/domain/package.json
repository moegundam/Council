{
  "name": "@council/domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "imports": {
    "#*": {
      "types": "./src/*.ts",
      "development": "./src/*.ts",
      "import": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./skill-context": {
      "types": "./src/skill-context.ts",
      "development": "./src/skill-context.ts",
      "import": "./dist/skill-context.js"
    },
    "./meeting-scheduling": {
      "types": "./src/meeting-scheduling.ts",
      "development": "./src/meeting-scheduling.ts",
      "import": "./dist/meeting-scheduling.js"
    },
    "./agent-readiness": {
      "types": "./src/agent-readiness.ts",
      "development": "./src/agent-readiness.ts",
      "import": "./dist/agent-readiness.js"
    },
    "./platform-views": {
      "types": "./src/platform-views.ts",
      "development": "./src/platform-views.ts",
      "import": "./dist/platform-views.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@council/contracts": "workspace:*",
    "ipaddr.js": "2.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.3.0"
  },
  "license": "AGPL-3.0-only"
}
