    "@fastify/rate-limit": "11.1.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "argon2": "0.44.0",
    "bullmq": "5.80.2",
    "fastify": "5.11.3",
    "ioredis": "5.11.1",
    "zod": "4.4.3"
